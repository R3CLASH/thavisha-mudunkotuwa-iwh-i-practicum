doctype html
html(lang="en")
    head
        title= title
        meta(name="viewport" content="width=device-width, initial-scale=1")
        link(rel="stylesheet", href="/css/style.css")
    body
        h1= title
        a(href="/update-cobj") Add to this table
        
        table
            thead
                tr
                    th Game Name
                    th Game Type
                    th Game Genre
            tbody
                each game in data
                    tr
                        td #{game.properties.game_name}
                        td #{game.properties.game_type}
                        td #{game.properties.game_genre}
