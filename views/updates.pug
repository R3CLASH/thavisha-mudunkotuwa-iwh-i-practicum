doctype html
html(lang="en")
    head
        title= title
        meta(name="viewport" content="width=device-width, initial-scale=1")
        link(rel="stylesheet", href="/css/style.css")
    body
        h1= title
        a(href="/") Return to the homepage
        
        .form-wrapper
            form(action="/update-cobj" method="POST")
                .form-group
                    label(for="game_name") Game Name 
                    input(type="text" name="game_name" id="game_name" required)
                .form-group
                    label(for="game_type") Game Type 
                    input(type="text" name="game_type" id="game_type" required)
                .form-group
                    label(for="game_genre") Game Genre 
                    input(type="text" name="game_genre" id="game_genre" required)
                button(type="submit") Submit
